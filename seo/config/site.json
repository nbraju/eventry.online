  "existingUrls": ["/"],
  "protectedFiles": ["index.html", "sw.js", "manifest.json", "manifest.webmanifest", "CNAME", "llms.txt", "404.html", "favicon.ico"],
  "reservedPaths": ["assets", "css", "js", "img", "images", "icons", "seo", "blog", "api", "static", "node_modules", ".github"]
