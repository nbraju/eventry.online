{
  "baseUrl": "https://eventry.online",
  "brand": "Eventry",
  "locale": "en-IN",
  "themeColor": "#2A2868",
  "appUrl": "https://eventry.online/",
  "listVendorUrl": "https://eventry.online/",
  "vendorLinkTemplate": null,
  "ogImage": null,
  "directoryPath": "locations",
  "minVendorsToIndex": 3,
